<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- %mmsg：敏感字段入日志前兜底打码；[%X{traceId}]：每行日志携带 TraceId -->
    <conversionRule conversionWord="mmsg" converterClass="com.evops.common.log.MaskingMessageConverter"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId}] %logger{36} - %mmsg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
